{
  "name": "loopy-to-logic",
  "version": "1.0.0",
  "description": "Migrate a Loopy Pro project to Logic Pro for iPad: stems, MIDI, automation and an effects manifest. Runs entirely in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "export:midi": "node scripts/export-midi.mjs examples/midi",
    "export:stems": "node scripts/export-stems.mjs examples/stems",
    "export:manifest": "node scripts/manifest.mjs examples/manifest.md"
  },
  "type": "module",
  "dependencies": {
    "fflate": "^0.8.3",
    "soundtouchjs": "^0.3.0",
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12"
  },
  "private": true
}
